# Environment Variables for Siimba Website
# Copy this file to .env.local and fill in your actual values

# ============================================
# GOOGLE SHEETS (Required for collecting signups)
# ============================================
# Get this from your Google Apps Script deployment
# See GOOGLE-SHEETS-SETUP.md for instructions
NEXT_PUBLIC_GOOGLE_SHEET_URL=

# ============================================
# RESEND (Required for sending welcome emails)
# ============================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# From email address (must be verified in Resend)
# For testing: onboarding@resend.dev
# For production: hello@yourdomain.com
FROM_EMAIL=

# ============================================
# CALENDLY (Optional)
# ============================================
# Your Calendly booking link
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/siimba
