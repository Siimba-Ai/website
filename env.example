# Copy this to .env.local and fill in your values

# Calendly booking link (optional)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/siimba

# Google Sheets Web App URL for waitlist form submissions
# Follow the setup instructions in GOOGLE-SHEETS-SETUP.md
NEXT_PUBLIC_GOOGLE_SHEET_URL=

# Resend API Key (server-side only)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address for welcome emails (must be verified in Resend for production)
# Example: Siimba <hello@siimba.ai>
RESEND_FROM_EMAIL=

# Optional: Resend template ID for welcome email.
# If omitted, API route will send a built-in HTML/text welcome email.
RESEND_WELCOME_TEMPLATE_ID=
